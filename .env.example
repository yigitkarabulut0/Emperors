# Copy to .env and fill in. .env is gitignored; never commit real values.

EMPERORS_ENV=dev
EMPERORS_ADDR=:8080
EMPERORS_LOG_LEVEL=debug

# Neon POOLED endpoint — all request traffic.
DATABASE_URL='postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require'
# Neon DIRECT (unpooled) endpoint — migrations only. Same host without "-pooler".
DATABASE_URL_DIRECT='postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require'

# Art pipeline (Google AI Studio)
GOOGLE_API_KEY=
