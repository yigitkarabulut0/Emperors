# --- secrets ---
.env
.env.*
!.env.example
*.pem
*.key
!infra/*.pub
infra/secrets.env

# --- Godot ---
client/.godot/
client/android/
client/ios/
client/build/
client/export/
*.translation

# --- Go ---
server/bin/
server/tmp/
*.test
coverage.out

# --- Node ---
node_modules/
admin/.next/
admin/out/
admin/.turbo/
*.tsbuildinfo

# --- Python (art pipeline) ---
art/.venv/
__pycache__/
*.pyc

# --- art workspace: generation intermediates are NOT shipped, but ARE versioned ---
# (nothing ignored here on purpose: paid art must be committed.)
# Only true scratch is ignored:
art/**/_qa/
art/**/*.tmp.png

# --- macOS / editors ---
.DS_Store
.vscode/
.idea/

# Next.js admin panel
admin/node_modules/
admin/.next/
admin/next-env.d.ts

# Written by scripts/deploy-iphone.sh; holds a machine-specific LAN address.
client/env.build.json

# Generation intermediates. The raw render is the source and is kept; the matted
# working copy and the style probes are reproducible from it.
art/**/*_cut.png
art/styletest/
