; Emperors — Godot 4.7 project configuration (rebuild).
;
; The reference paintings are 941x1672, so the game runs at exactly that base size:
; a pixel in art/reference/ is a layout unit here, and every crop is drawn 1:1.
; canvas_items + expand: taller phones get more vertical canvas, never letterboxing.

config_version=5

[application]

config/name="Emperors"
config/description="A 2D idle/RPG kingdom game."
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.043, 0.082, 0.122, 1)
boot_splash/show_image=false
boot_splash/minimum_display_time=0

[autoload]

; Load order matters: each may only reference the ones above it.
Env="*res://scripts/autoload/env.gd"
Nav="*res://scripts/autoload/nav.gd"
Api="*res://scripts/autoload/api.gd"
Session="*res://scripts/autoload/session.gd"
GameState="*res://scripts/autoload/game_state.gd"
Art="*res://scripts/autoload/art.gd"
Proof="*res://scripts/dev/proof.gd"

[display]

window/size/viewport_width=941
window/size/viewport_height=1672
window/size/window_width_override=470
window/size/window_height_override=836
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

environment/defaults/default_clear_color=Color(0.043, 0.082, 0.122, 1)
renderer/rendering_method="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[gui]

theme/default_font_multichannel_signed_distance_field=false
